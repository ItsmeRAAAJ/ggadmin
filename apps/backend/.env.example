POSTGRES_USER=myggits_admin
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=myggits_prod
DATABASE_URL=postgresql://myggits_admin:changeme_strong_password@postgres:5432/myggits_prod

JWT_SECRET=changeme_long_random_string_min_32_chars
OTP_PEPPER=changeme_another_random_string_min_32_chars

BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@mail.shubhashish.me
BREVO_SENDER_NAME="My GGITS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=myggits-student-files

NODE_ENV=development
PORT=3001
APP_NAME="My GGITS"
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Only honoured by prisma/seed.ts (initial Super Admin). Required when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@ggits.ac.in
SEED_ADMIN_PASSWORD=
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY_HOPS=1
