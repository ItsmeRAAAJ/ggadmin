  "main": "index.js",
  "scripts": {
    "start": "node ./dist/src/index.js",
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "dev:compiled": "tsc -b && node ./dist/src/index.js",
    "db:generate": "mkdir -p node_modules/@prisma && cp -R ../../node_modules/@prisma/client node_modules/@prisma/client 2>/dev/null || true && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:compiled": "node ./dist/prisma/seed.js",
    "db:studio": "prisma studio"
  },
