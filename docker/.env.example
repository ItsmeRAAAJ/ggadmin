# Copy to docker/.env on the server and replace every "changeme" value.
# Generate secrets with: openssl rand -hex 32

# Postgres
POSTGRES_USER=myggits_admin
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=myggits_prod
# Host must be "postgres" (the compose service name); user/password/db must match the values above
DATABASE_URL=postgresql://myggits_admin:changeme_strong_password@postgres:5432/myggits_prod

# Auth (each at least 32 random characters)
JWT_SECRET=changeme_long_random_string_min_32_chars
OTP_PEPPER=changeme_another_random_string_min_32_chars

# Brevo (email) — required in production, OTPs are only logged to the console in development
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@mail.shubhashish.me
BREVO_SENDER_NAME="My GGITS"

# AWS S3 (ap-south-1 / Mumbai) — bucket needs CORS allowing PUT from the admin origin
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=myggits-student-files

# App
APP_NAME="My GGITS"
# Comma-separated admin panel origin(s). The mobile app is not subject to CORS.
ALLOWED_ORIGINS=https://admin.your-domain.com
# Number of reverse proxies in front of the API (Caddy = 1)
TRUST_PROXY_HOPS=1
# Host port Caddy proxies to (127.0.0.1 only)
BACKEND_HOST_PORT=3001

# Initial super admin — used only by: docker compose exec backend node dist/prisma/seed.js
SEED_ADMIN_EMAIL=admin@ggits.ac.in
SEED_ADMIN_PASSWORD=
