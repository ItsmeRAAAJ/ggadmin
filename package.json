{
  "name": "my-ggits",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.6.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-svg": "15.15.3"
  }
}
